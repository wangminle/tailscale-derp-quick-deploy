# 仅白名单数据，不能使用引号、变量或命令；凭据不得写在这里。
CONFIG_VERSION=1
IP_ADDR=203.0.113.10
DERP_PORT=30399
STUN_PORT=3478
CERT_DAYS=365
DERPER_VERSION=v1.104.1
REGION_ID=900
REGION_CODE=my-derp
REGION_NAME=My IP DERP
RUN_USER=derper
VERIFY_CLIENTS_MODE=on
SECURITY_LEVEL=standard
TLS_CONNLIMIT=0
# 公网部署保持0并替换上面的示例IP；仅显式内网测试时改成1。
ALLOW_NON_GLOBAL_IP=0
# 独立合法客户端适配器：按文档实现后才启用，不能用固定成功脚本。
# EXTERNAL_PROBE=/usr/local/libexec/derper-external-probe
PROBE_TIMEOUT=15
PROBE_MAX_AGE=60
REQUIRE_H3=0
METRICS_MAX_AGE=900
